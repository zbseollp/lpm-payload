pipeline {
  agent any

  options {
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'tenant_slug', description: 'Tenant slug', trim: true)
    string(name: 'reason', defaultValue: 'publish', description: 'Trigger reason', trim: true)
    choice(name: 'deploy_mode', choices: ['monorepo', 'external'], description: 'Deploy mode')
    string(name: 'github_repo', defaultValue: '', description: 'owner/repo for external site', trim: true)
    string(name: 'github_branch', defaultValue: 'main', description: 'Client repo branch', trim: true)
    string(name: 'blog_content_path', defaultValue: 'src/content/blog', description: 'Blog path in site repo', trim: true)
  }

  environment {
    PAYLOAD_API_KEY = "${env.PAYLOAD_API_KEY ?: ''}"
    PLATFORM_GIT_URL = "${env.PLATFORM_GIT_URL ?: ''}"
    PLATFORM_GIT_BRANCH = "${env.PLATFORM_GIT_BRANCH ?: 'main'}"
    GITHUB_OWNER = "${env.GITHUB_OWNER ?: ''}"
    GITHUB_REPO = "${env.GITHUB_REPO ?: 'astropayload'}"
    CLOUDFLARE_WORKERS_DEV_SUBDOMAIN = "${env.CLOUDFLARE_WORKERS_DEV_SUBDOMAIN ?: ''}"
    ALLOWED_GITHUB_ORGS = "${env.ALLOWED_GITHUB_ORGS ?: ''}"
    CLIENT_REPO_SECURITY_SCAN = "${env.CLIENT_REPO_SECURITY_SCAN ?: '1'}"
    ASTROPAYLOAD_CLIENT_ENV_DIR = "${env.ASTROPAYLOAD_CLIENT_ENV_DIR ?: "${env.JENKINS_HOME}/astropayload-client-env"}"
    LPM_SECRETS_URL = "${env.LPM_SECRETS_URL ?: ''}"
    LPM_SECRETS_TOKEN = "${env.LPM_SECRETS_TOKEN ?: ''}"
    ASTROPAYLOAD_SECRETS_URL = "${env.ASTROPAYLOAD_SECRETS_URL ?: ''}"
    ASTROPAYLOAD_SECRETS_TOKEN = "${env.ASTROPAYLOAD_SECRETS_TOKEN ?: ''}"
    R2_PUBLIC_URL = "${env.R2_PUBLIC_URL ?: ''}"
    PUBLIC_R2_URL = "${env.PUBLIC_R2_URL ?: env.R2_PUBLIC_URL ?: ''}"
    PUBLIC_PAYLOAD_MEDIA_URL = "${env.PUBLIC_PAYLOAD_MEDIA_URL ?: env.R2_PUBLIC_URL ?: ''}"
  }

  stages {
    stage('Deploy tenant') {
      steps {
        script {
          def secrets = load 'jenkins/withJobSecrets.groovy'
          def siteEnvCredId = "astropayload-site-env-${params.tenant_slug}"
          def runDeploy = {
            sh '''
              chmod +x jenkins/scripts/*.sh
              bash jenkins/scripts/tenant-deploy.sh
            '''
          }

          secrets.withJobSecrets {
            try {
              withCredentials([file(credentialsId: siteEnvCredId, variable: 'CLIENT_BUILD_ENV_FILE')]) {
                echo "Binding optional client build env credential: ${siteEnvCredId}"
                runDeploy()
              }
            } catch (err) {
              def msg = "${err}"
              if (msg.contains('CredentialNotFound') || msg.contains('could not find credentials') || msg.contains('Could not find credentials')) {
                echo "No Jenkins Secret file '${siteEnvCredId}' — will try ASTROPAYLOAD_CLIENT_ENV_DIR/${params.tenant_slug}.env if present"
                runDeploy()
              } else {
                throw err
              }
            }
          }
        }
      }
    }
  }
}
