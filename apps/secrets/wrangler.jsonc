{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lpm-payload-secret",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-20",
	// Hourly scheduled-publish run (see src/index.ts). Cloudflare cron, UTC.
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		// Override in Cloudflare dashboard: Payload VPS IP.
		// GitHub Actions uses role=github (token only; hosted runners have no stable IP).
		"ALLOWED_IPS": ""
	}
}
