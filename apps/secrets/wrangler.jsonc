{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lpm-payload-secret",
	// Pinned: this Worker lives in the zbseo.uk account, NOT the zb-marketing one
	// that holds the tenant sites. Without this, a default `wrangler login` deploys
	// a second, secret-less Worker into the wrong account and nothing changes here.
	"account_id": "54b144d6836138e432688b9d5f4ec8aa",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-20",
	// Hourly scheduled-publish run (see src/index.ts). Cloudflare cron, UTC.
	"triggers": {
		"crons": ["0 * * * *"]
	},
	// ALLOWED_IPS (the Payload VPS IP, used by role=payload) is set in the
	// Cloudflare dashboard and deliberately NOT given a value here. Deploy with
	// --keep-vars, as `pnpm deploy` does: a plain `wrangler deploy` would push
	// this empty placeholder over the live value and role=payload would start
	// answering "ALLOWED_IPS is not configured", breaking Payload's own secret
	// load on its next restart.
	"vars": {
		"ALLOWED_IPS": ""
	}
}
