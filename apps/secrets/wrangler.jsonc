{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lpm-payload-secret",
	// Pinned: this Worker lives in the zbseo.uk account, NOT the zb-marketing one
	// that holds the tenant sites. Without this, a default `wrangler login` deploys
	// a second, secret-less Worker into the wrong account and nothing changes here.
	"account_id": "54b144d6836138e432688b9d5f4ec8aa",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-29",
	// Hourly scheduled-publish run (see src/index.ts). Cloudflare cron, UTC.
	"triggers": {
		"crons": ["0 * * * *"]
	}
	// NO "vars" BLOCK ON PURPOSE.
	//
	// ALLOWED_IPS (the Payload VPS IPs, used by role=payload) is set in the
	// Cloudflare dashboard. It used to be declared here as an empty placeholder,
	// which wiped the live value on every deploy: --keep-vars only preserves
	// vars that are ABSENT from this file — a var declared here, even as "", is
	// pushed and overwrites the dashboard. The empty value then makes
	// role=payload answer "ALLOWED_IPS is not configured" and Payload loses its
	// own secret load on the next restart. Verified the hard way 2026-10-30.
	//
	// Leave dashboard-managed vars out of this file entirely.
}
